              "default": 200000,
              "min": 10000,
              "max": 1000000,
              "step": 10000
            }
          ],
          "checks": [
            {
              "text": "numpy 向量化相对纯 Python 加速 > 20x",
              "re": "numpy 向量化\\s+[\\d.]+\\s+(\\d+)x",
              "cmp": ">",
              "value": 20
            },
            {
              "text": "布尔掩码写法反而更慢（加速比明显低于朴素向量化）",
