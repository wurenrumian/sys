{
  "title": "AI 基础设施 · 讲解与可验证演示",
  "subtitle": "字节搜广推架构联合实验室 · AI基础设施方向",
  "modules": [
    {
      "id": "00_overview",
      "title": "总览 · 知识地图",
      "hook": "三个方向其实是一次训练 step 的三段时间。先看这张地图再决定读哪里。",
      "doc": "00_overview/README.md",
      "demos": []
    },
    {
      "id": "01_data_storage",
      "title": "01 · 数据计算与存储中台",
      "hook": "千亿级/日的行为数据 + 多模态：存不下、读不快、CPU 的 ETL 喂不饱 GPU。",
      "doc": "01_data_storage/README.md",
      "demos": [
        {
          "file": "01_data_storage/demo1_row_vs_col.py",
          "title": "demo1 · 行存 vs 列存",
          "hook": "训练只用 3/40 个字段时，按行存要把 100% 的字节都搬一遍。",
          "doc": "01_data_storage/demo1_row_vs_col.md",
          "runtime_s": 3.5,
          "params": [
            {
              "name": "N_ROWS",
              "label": "样本行数",
              "type": "int",
              "default": 200000,
              "min": 10000,
              "max": 500000,
              "step": 10000
            },
            {
              "name": "N_COLS",
              "label": "字段数",
              "type": "int",
              "default": 40,
              "min": 4,
              "max": 80,
              "step": 1
            },
            {
              "name": "N_PROJ",
              "label": "训练用到几个字段",
              "type": "int",
              "default": 3,
              "min": 1,
              "max": 40,
              "step": 1
            }
          ],
          "checks": [
            {
              "text": "投影扫描的 I/O 量降到 30% 以下（默认参数 = 3/40 = 7.5%）",
              "re": "I/O 量降为 ([\\d.]+)%",
              "cmp": "<",
              "value": 30
            },
            {
              "text": "列存整表压缩比 > 6x",
              "re": "列存整表\\s*:\\s*([\\d.]+)x",
              "cmp": ">",
              "value": 6
            },
            {
              "text": "单调时间戳列的压缩比 > 50x —— 同质数据放一起熵更低",
              "re": "时间戳\\(单调\\)\\s+([\\d.]+)x",
              "cmp": ">",
              "value": 50
            },
            {
              "text": "分列之后每种列类型的最优编码各不相同（时间戳靠 delta，枚举靠 bit-pack）",
              "re": "时间戳\\(单调\\)\\s+->\\s+delta\\+zlib"
            },
            {
              "text": "delta 编码让单调时间戳列的压缩比超过 100x",
              "re": "delta\\+zlib\\s+\\(([\\d.]+)x\\)",
              "cmp": ">",
              "value": 100
            }
          ]
        },
        {
          "file": "01_data_storage/demo2_cache_tier.py",
          "title": "demo2 · 多级存储与 Embedding Cache",
          "hook": "Zipf 长尾下 1% 的缓存吃掉大半流量；但热点 churn 会让 LFU 的优势反转。",
          "doc": "01_data_storage/demo2_cache_tier.md",
          "runtime_s": 11,
          "params": [
            {
              "name": "N_KEYS",
              "label": "Embedding 表 key 数",
              "type": "int",
              "default": 1000000,
              "min": 10000,
              "max": 5000000,
              "step": 100000
            },
            {
              "name": "N_REQ",
              "label": "请求数",
              "type": "int",
              "default": 400000,
              "min": 20000,
              "max": 1000000,
              "step": 20000
            },
            {
              "name": "ZIPF_A",
              "label": "Zipf 指数（越大越集中）",
              "type": "float",
              "default": 1.15,
              "min": 1.01,
              "max": 2.0,
              "step": 0.01
            },
            {
              "name": "CHURN_EVERY",
              "label": "多少请求换一批热点",
              "type": "int",
              "default": 50000,
              "min": 1000,
              "max": 400000,
              "step": 1000
            },
            {
              "name": "CACHE_RATIO",
              "label": "churn 实验的缓存容量占比",
              "type": "float",
              "default": 0.01,
              "min": 0.001,
              "max": 0.5,
              "step": 0.001
            }
          ],
          "checks": [
            {
              "text": "最热的 1% key 承接了 50% 以上的请求",
              "re": "最热的 1% 承接了 ([\\d.]+)% 的请求",
              "cmp": ">",
              "value": 50
            },
            {
              "text": "1% 容量的缓存命中率 > 60%（缓存在推荐场景性价比极高）",
              "re": "1\\.0%\\s+[\\d,]+\\s+([\\d.]+)%",
              "cmp": ">",
              "value": 60
            },
            {
              "text": "热点 churn 下 LFU 的掉幅比 LRU 更大（陈旧计数挡住新热点）",
              "re": "LFU\\s+[\\d.]+%\\s+[\\d.]+%\\s+(-[\\d.]+)%",
              "cmp": "<",
              "value": -2.3
            },
            {
              "text": "Belady 最优上界高于所有可实现策略（离上界仍有差距）",
              "re": "1\\.0%\\s+[\\d,]+(?:\\s+[\\d.]+%){6}\\s+([\\d.]+)%",
              "cmp": ">",
              "value": 74
            },
            {
              "text": "扩容带来的收益大于换策略：0.1%→1% 容量的提升超过 10 个点",
              "re": "1\\.0%\\s+[\\d,]+\\s+([\\d.]+)%",
              "cmp": ">",
              "value": 66
            },
            {
              "text": "churn 下 W-TinyLFU 的掉幅比 LRU 更大（先验成了负资产）",
              "re": "W-TinyLFU\\s+[\\d.]+%\\s+[\\d.]+%\\s+(-[\\d.]+)%",
              "cmp": "<",
              "value": -8
            },
            {
              "text": "自适应窗口把 churn 掉幅救回一半以上",
              "re": "自适应W-TinyLFU\\s+[\\d.]+%\\s+[\\d.]+%\\s+(-[\\d.]+)%",
              "cmp": ">",
              "value": -8
            }
          ]
        },
        {
          "file": "01_data_storage/demo3_data_quality.py",
          "title": "demo3 · DCAI：数据事故如何静悄悄打掉 AUC",
          "hook": "PSI 漏掉了两类事故 —— AUC 掉了 2 个点它还报“正常”。",
          "doc": "01_data_storage/demo3_data_quality.md",
          "runtime_s": 4,
          "params": [
            {
              "name": "N_TRAIN",
              "label": "训练样本数",
              "type": "int",
              "default": 60000,
              "min": 5000,
              "max": 300000,
              "step": 5000
            },
            {
              "name": "N_SERVE",
              "label": "线上样本数",
              "type": "int",
              "default": 30000,
              "min": 5000,
              "max": 200000,
              "step": 5000
            },
            {
              "name": "N_FEAT",
              "label": "特征维数",
              "type": "int",
              "default": 12,
              "min": 5,
              "max": 64,
              "step": 1
            },
            {
              "name": "SKEW_RATIO",
              "label": "离在线不一致的污染比例",
              "type": "float",
              "default": 0.3,
              "min": 0.0,
              "max": 1.0,
              "step": 0.05
            },
            {
              "name": "PSI_BINS",
              "label": "PSI 分桶数",
              "type": "int",
              "default": 10,
              "min": 3,
              "max": 50,
              "step": 1
            }
          ],
          "checks": [
            {
              "text": "事故1（特征全变默认值）被 PSI 抓到：PSI > 1",
              "re": "特征缺失.*?[\\d.]+\\s+-[\\d.]+\\s+([\\d.]+)",
              "cmp": ">",
              "value": 1.0
            },
            {
              "text": "事故3（离在线不一致）AUC 掉了，但 PSI < 0.1 判定为“正常”",
              "re": "离在线不一致.*?[\\d.]+\\s+-[\\d.]+\\s+([\\d.]+)\\s+feat",
              "cmp": "<",
              "value": 0.1
            },
            {
              "text": "事故3 的 AUC 掉幅超过 1 个点（PSI 却毫无反应）",
              "re": "但 AUC 掉了 -([\\d.]+)",
              "cmp": ">",
              "value": 0.01
            },
            {
              "text": "特征污染 100% 时 AUC 单调下滑，而 PSI 全程约等于 0",
              "re": "100%\\s+([\\d.]+)\\s+[\\d.]+\\s+-[\\d.]+",
              "cmp": "<",
              "value": 0.05
            },
            {
              "text": "没有任何单一指标能抓到全部四种事故（最好的也 < 4/4）",
              "re": "抓到几种事故 \\(共 4 种\\)(?:\\s+\\d/4)*\\s+(\\d)/4",
              "cmp": "<",
              "value": 4
            },
            {
              "text": "四个边缘分布类指标（PSI/KS/JS/Wasserstein）抓到的事故数完全相同 —— 互为冗余",
              "re": "抓到几种事故 \\(共 4 种\\)\\s+1/4\\s+2/4\\s+2/4\\s+2/4\\s+2/4"
            },
            {
              "text": "关联类指标（互信息）抓到的事故比任何分布类指标都多",
              "re": "抓到几种事故 \\(共 4 种\\)(?:\\s+\\d/4){6}\\s+(\\d)/4",
              "cmp": ">",
              "value": 2
            }
          ]
        },
        {
          "file": "01_data_storage/demo4_jagged_padding.py",
          "title": "demo4 · 不定长序列的 padding 浪费",
          "hook": "动态 padding 几乎白干；真正有效的是按长度排序分桶。",
          "doc": "01_data_storage/demo4_jagged_padding.md",
          "runtime_s": 0.3,
          "params": [
            {
              "name": "N_USERS",
              "label": "样本数",
              "type": "int",
              "default": 200000,
              "min": 10000,
              "max": 500000,
              "step": 10000
            },
            {
              "name": "MAX_LEN",
              "label": "序列长度上限",
              "type": "int",
              "default": 1024,
              "min": 64,
              "max": 4096,
              "step": 64
            },
            {
              "name": "BATCH",
              "label": "batch size",
              "type": "int",
              "default": 512,
              "min": 8,
              "max": 8192,
              "step": 8
            },
            {
              "name": "SIGMA",
              "label": "长度分布长尾程度",
              "type": "float",
              "default": 1.6,
              "min": 0.2,
              "max": 3.0,
              "step": 0.1
            }
          ],
          "checks": [
            {
              "text": "全局 padding 的槽位放大 > 5x（绝大部分算力烧在补零上）",
              "re": "全局 padding.*?([\\d.]+)x",
              "cmp": ">",
              "value": 5
            },
            {
              "text": "动态 padding 几乎没有收益：放大倍数仍 > 5x",
              "re": "动态 padding \\(补到批内 max\\).*?([\\d.]+)x",
              "cmp": ">",
              "value": 5
            },
            {
              "text": "排序分桶把放大倍数压到 1.5x 以内，逼近 Jagged 的理论下限",
              "re": "排序分桶 \\+ 动态 padding.*?([\\d.]+)x",
              "cmp": "<",
              "value": 1.5
            },
            {
              "text": "实测 jagged pooling 比 padded 快 2x 以上",
              "re": "耗时差 ([\\d.]+)x",
              "cmp": ">",
              "value": 2
            }
          ]
        },
        {
          "file": "01_data_storage/demo5_etl_overlap.py",
          "title": "demo5 · CPU 喂不饱 GPU：重叠、木桶与抖动",
