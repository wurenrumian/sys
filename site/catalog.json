              "max": 64,
              "step": 1
            },
            {
              "name": "QUEUE",
              "label": "prefetch 槽位数",
              "type": "int",
              "default": 2,
              "min": 1,
              "max": 64,
              "step": 1
            }
          ],
          "checks": [
            {
              "text": "重叠把端到端加速到 1.3x 以上（没有一行代码变快）",
              "re": "端到端快了 ([\\d.]+)x",
              "cmp": ">",
              "value": 1.3
            },
            {
              "text": "worker 加过拐点后收益归零（出现 +0.0% 的行）",
              "re": "比上一档快 \\+(0\\.0)%"
            },
            {
              "text": "队列槽位数是 worker 并行度的硬上限",
              "re": "给 8 个槽位时 = ([\\d.]+)ms",
              "cmp": "<",
              "value": 200
            },
            {
              "text": "优化非瓶颈（worker 翻倍）的收益精确等于 1.00x",
              "re": "worker 数翻倍 \\(加 CPU 核\\)\\s+[\\d.]+ms\\s+(1\\.00)x"
            }
          ]
        }
      ]
    },
    {
      "id": "02_compile",
      "title": "02 · 基础库团队 - 编译方向",
      "hook": "全链路 Python 胶水层拖慢迭代与延迟；显存碎片 + 动态 shape 让编译收益拿不到手。",
      "doc": "02_compile/README.md",
      "demos": [
        {
          "file": "02_compile/demo1_python_overhead.py",
          "title": "demo1 · Python 解释器开销有多大",
          "hook": "两种“看起来更优”的手工优化，分别慢了 2.5x 和 7.7x。",
          "doc": "02_compile/demo1_python_overhead.md",
          "runtime_s": 1.0,
          "params": [
            {
              "name": "N",
              "label": "元素个数",
              "type": "int",
              "default": 2000000,
              "min": 100000,
              "max": 8000000,
              "step": 100000
